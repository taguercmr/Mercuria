APP_NAME=Mercuria
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Replace with the actual public HTTPS domain before deployment.
APP_URL=https://example.invalid
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mercuria
DB_USERNAME=mercuria
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Hostinger mutualisé désactive les liens symboliques. Utilisez le chemin absolu
# du dossier public/storage afin que les fichiers publics restent accessibles.
PUBLIC_DISK_ROOT=/home/USER/domains/DOMAIN/public_html/SUBDOMAIN/public/storage

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=mercuria@traguer.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=mercuria@traguer.com
MAIL_FROM_NAME="Mercuria by Traguer AI"

# Credentials may instead be saved, encrypted, in Admin > Paiements.
PAYMENT_PROVIDER=camerpay
PAYMENT_CURRENCY=XAF
CAMERPAY_API_TOKEN=
CAMERPAY_CALLBACK_SECRET=
CAMERPAY_BASE_URL=https://camerpay.biz/api

MERCURIA_SEARCH_DRIVER=auto
MERCURIA_PRO_PRICE_MONTHLY=9900
MERCURIA_PRO_PRICE_YEARLY=99000
SCOUT_DRIVER=collection
VITE_APP_NAME="${APP_NAME}"
