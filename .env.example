APP_NAME=Mercuria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mercuria
DB_USERNAME=root
DB_PASSWORD=

# Alternative SQLite :
# DB_CONNECTION=sqlite
# # et créer database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mercuria.cm"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Paiements — CamerPay (primaire). Configurable aussi via Admin > Paiements.
PAYMENT_PROVIDER=camerpay
PAYMENT_CURRENCY=XAF
MERCURIA_PRO_PRICE_MONTHLY=9900
MERCURIA_PRO_PRICE_YEARLY=99000

CAMERPAY_API_TOKEN=
CAMERPAY_CALLBACK_SECRET=
CAMERPAY_BASE_URL=https://camerpay.biz/api

FAPSHI_APIUSER=
FAPSHI_APIKEY=
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_WEBHOOK_SECRET=

CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_NOTIFY_SECRET=

# Recherche (optionnel) — sans Meilisearch, fallback SQL automatique
MERCURIA_SEARCH_DRIVER=auto
SCOUT_DRIVER=collection
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

